<li id="skill-<%= skill.id %>">
   <article 
      class="card gap-4 transition-all duration-500 hover:-translate-y-2.5"
      style="--skill-color: <%= skill.color %>;">

      <div class="flex items-center gap-4">
         <div class="flex h-16 w-16 items-center justify-center rounded-xl bg-linear-to-r from-(--skill-color) to-(--skill-color)/30 shadow-brand">
            <%= image_tag skill.icon.attached? ? url_for(skill.icon) : 'default_pic.png',
                     alt: skill.name,
                     class: 'h-full w-full object-contain',
                     loading: 'lazy' %>
         </div>
         <div class="flex flex-col justify-between gap-2">
            <%= link_to skill.name, users_skill_path(skill), class: 'text-3xl sm:text-xl md:text-2xl text-content' %>
            <span class="text-sm text-content/70"><%= skill.category_human %></span>
         </div>
      </div>

      <p class="grow text-sm text-content/90">
         <%= skill.short_description %>
      </p>

      <div class="flex flex-wrap gap-2">
         <%= safe_join(skill.tags.map { |tag| content_tag(:span, tag.name, class: 'badge', title: tag.name) }) %>
      </div>

      <hr class="border-content/10">

      <div class="flex flex-wrap justify-center gap-2.5">

         <%= link_to edit_users_skill_path(skill),
                     class: 'flex-1 py-2 px-3 bg-content/5 rounded-lg border border-content/10 text-center text-content hover:bg-primary/20 focus:outline-none focus:ring-2 focus:ring-primary',
                     aria: { label: t('skills.edit', name: skill.name) } do %>

            <%= icon(:pen, class: 'mr-1 inline-block h-4 w-4') %>
            <span><%= t('skills.edit') %></span>

         <% end %>

         <%= link_to users_skill_path(skill), 
                     data: { turbo_method: :delete, turbo_confirm: t('.confirm') },
                     class: 'flex-1 py-2 px-3 bg-content/5 rounded-lg border border-content/10 text-center text-content hover:bg-rose-400/20 hover:border-rose-400/30 focus:outline-none focus:ring-2 focus:ring-rose-400' do %>

            <%= icon(:trash, class: 'mr-1 inline-block h-4 w-4') %>
            <span><%= t('skills.delete') %></span>

         <% end %>

      </div>

   </article>
</li>